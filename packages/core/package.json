{
  "name": "@gijun-ai/core",
  "version": "0.2.0",
  "description": "Core audit/HITL/policy engine for gijun-ai (personal single-user workbench)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsc -p tsconfig.test.json && node --test 'dist-test/__tests__/*.test.js'",
    "coverage": "tsc -p tsconfig.test.json && c8 --config ../../.c8rc.json --check-coverage node --test 'dist-test/__tests__/*.test.js'",
    "coverage:report": "tsc -p tsconfig.test.json && c8 --config ../../.c8rc.json node --test 'dist-test/__tests__/*.test.js'"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "@types/node": "^25.6.0"
  }
}
